#include <stdio.h>
int main(){
    int n, t1=0,t2=1,next;
    printf("Enter Number: ");
    scanf("%d",&n);
    printf("Fibonacci Series up to %d terms:\n", n);
    for(int i=0;i<n;i++){
        if(i==0){
            printf("%d ",t1);
            continue;
        }
        if(i==1){
            printf("%d ",t2);
            continue;
        }
        next=t1+t2;
        t1=t2;
        t2=next;
        printf("%d ",next);
    }
    return 0;
